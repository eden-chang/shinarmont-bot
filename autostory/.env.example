# 마스토돈 스토리 스크립트 자동 출력 봇 환경 변수 설정 예시
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요

# ==============================================
# 마스토돈 API 설정 (필수)
# ==============================================

# 마스토돈 인스턴스 URL (https:// 포함)
MASTODON_INSTANCE_URL=https://your-instance.com

# Mastodon API 설정 (동적 계정 시스템)
# 사용할 계정들을 콤마로 구분하여 나열 (대소문자 무관)
MASTODON_ACCOUNTS=notice,system,story

# 각 계정별 액세스 토큰 설정 (계정명은 대문자로)
NOTICE_ACCESS_TOKEN=
SYSTEM_ACCESS_TOKEN=
STORY_ACCESS_TOKEN=

# 기본 계정 설정 (선택사항, 미설정시 첫 번째 계정 사용)
DEFAULT_MASTODON_ACCOUNT=notice

# 명령어 수령 담당 계정 (스토리 진행 명령어를 받을 계정)
# [스토리/워크시트명], [스진/워크시트명] 등의 Direct 메시지를 모니터링할 계정
# 기본값: story (대소문자 무관)
COMMAND_RECEIVER_ACCOUNT=story

# Google Sheets 설정 (필수)
GOOGLE_SHEETS_ID=google-sheet-id

# 기본 시트 탭 이름 (실제로는 워크시트별로 동적 조회)
GOOGLE_SHEETS_TAB=테스트

# 시스템 관리자 계정 ID (비상 시 DM 전송용)
SYSTEM_ADMIN_ID=longwhile

# ==============================================
# 봇 동작 설정 (선택사항)
# ==============================================

# 시간대 - 기본값: Asia/Seoul
TIMEZONE=Asia/Seoul

# 로그 레벨 - 기본값: INFO
# 가능한 값: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 파일 로깅 활성화 여부 - 기본값: true
LOG_TO_FILE=true

# 로그 파일 로테이션 - 기본값: daily
LOG_ROTATION=daily

# ==============================================
# 고급 설정 (선택사항)
# ==============================================

# 한 번에 조회할 최대 행 수 - 기본값: 1000
MAX_ROWS_PER_REQUEST=1000

# Google Sheets API 호출 제한 (100초당 최대 요청 수) - 기본값: 100
SHEETS_RATE_LIMIT_REQUESTS=100

# 알림 확인 간격 (초) - 기본값: 5
NOTIFICATION_CHECK_INTERVAL=5

# 최대 동시 실행 세션 수 - 기본값: 5
MAX_CONCURRENT_SESSIONS=5

# ==============================================
# 알림 및 오류 처리 설정 (선택사항)
# ==============================================

# 오류 알림 활성화 여부 - 기본값: true
ERROR_NOTIFICATION_ENABLED=true



# ==============================================
# 사용법 안내 (동적 계정 시스템)
# ==============================================

# 1. 이 파일을 .env로 복사
# 2. MASTODON_ACCOUNTS에 사용할 계정 이름들을 콤마로 구분하여 설정
# 3. 각 계정별 ACCESS_TOKEN 설정 (형식: {계정명}_ACCESS_TOKEN)
# 4. DEFAULT_MASTODON_ACCOUNT 설정 (선택사항)
# 5. Google Sheets ID 설정 ('콜바 스토리 자동진행' 스프레드시트)
# 6. credentials.json 파일을 프로젝트 루트에 배치
# 7. python main.py 실행
#
# 동적 계정 시스템의 장점:
# - 환경 변수만 수정하면 다른 서버에서 바로 사용 가능
# - 코드 수정 없이 계정 추가/제거 가능
# - 대소문자 구분 없이 계정명 사용 가능 (notice, Notice, NOTICE 모두 동일)
#
# 명령어 사용법:
# - 누구든지 STORY 계정에게 Direct 메시지로 명령어 전송 가능
# - 형식: @story계정아이디 [스토리/워크시트명], [스진/워크시트명], [스토리진행/워크시트명]
# - 예시: @announce [스토리/테스트시트], @story [스진/시나리오1]
# - STORY 계정의 실제 사용자명은 API를 통해 자동으로 인식됩니다
#
# 워크시트 구조:
# - 각 워크시트에 '계정', '간격', '문구' 열 필요
# - 계정: 환경 변수에 설정된 계정 중 하나 (대소문자 무관)
# - 간격: 송출 간격 (초 단위, 정수)
# - 문구: 송출할 텍스트