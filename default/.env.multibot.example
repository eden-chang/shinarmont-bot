# ============================================================
# 멀티 봇 설정 (간소화 버전)
# ============================================================
# 이 파일을 .env로 복사하여 사용하세요: cp .env.multibot.example .env

# ============================================================
# 기본 설정
# ============================================================

# 멀티 봇 모드 활성화 (True: 여러 봇 동시 운영, False: 싱글봇)
ENABLE_MULTI_BOT=True

# BOT_COUNT는 참고용 표시값입니다. 실제 실행되는 봇은 아래 BOT*_ENABLED=True로
# 지정한 슬롯만 자동 탐지되어 실행됩니다. 슬롯 번호를 건너뛰어도 됩니다.
# (예: BOT1_ENABLED=False, BOT2_ENABLED=True, BOT5_ENABLED=True → 봇 2개 실행)
BOT_COUNT=2

# Google Sheets
SHEET_ID=
GOOGLE_CREDENTIALS_PATH=credentials.json

# Mastodon API
MASTODON_API_BASE_URL=https://example.xyz
MASTODON_ACCESS_TOKEN=

# ============================================================
# 조사(Investigation) 기능 설정
# ============================================================
# 자세한 사용법: docs/조사_자동봇_운영_가이드.txt 참고
# 활성화 시 BOT*_BOT_TYPE=investigate 인 봇이 [장소 목록]/[진입]/[조사]를 처리합니다.
INVESTIGATION_ENABLED=False
INVESTIGATION_SHEET_ID=                      # 조사 전용 보조 시트 ID
INVESTIGATION_ENTRY_SHEET=진입               # 장소 목록 워크시트 이름 (기본 '진입')

# 시스템 관리자 (콤마로 구분)
SYSTEM_ADMIN_ID=longwhile,NOTICE

# 봇 가동 기간 (KST 기준, 형식: YYYY.MM.DD)
# 시작일 00:00 ~ 종료일 23:59까지 가동, 만료 시 자동 종료 툿 게시
# 비워두면 무제한 가동
BOT_OPERATION_START=
BOT_OPERATION_END=

# ============================================================
# 게임 설정
# ============================================================

# 화폐
CURRENCY=골드
CURRENCY_EUNNEUN=는

# 게임 제한
MAX_MESSAGE_LENGTH=1000
BOT_MAX_DICE_COUNT=20
BOT_MAX_DICE_SIDES=1000

# ============================================================
# 프리미엄 기능
# ============================================================

PREMIUM_CUSTOMC_ENABLED=False
PREMIUM_IMAGE_ENABLED=False

# 양도 기능 세분화 (아이템 양도 / 소지금 양도 별도 제어)
PREMIUM_TRANSFER_ITEM_ENABLED=False    # 아이템 양도 허용 여부
PREMIUM_TRANSFER_MONEY_ENABLED=False   # 소지금 양도 허용 여부

PEEK_STATUS=False
PEEK_HEADER=체력,정신력,소지금,소지품

# 출석 기능 (ATTENDANCE_COMMAND 값이 명령어 이름과 '관리' 시트의 컬럼명으로 동시 사용)
# 예: ATTENDANCE_COMMAND=보고 으로 두면 [보고] 명령어가 동작하고 '관리' 시트의 '보고' 컬럼을 사용
ATTENDANCE_ENABLED=False
ATTENDANCE_COMMAND=출석
ATTENDANCE_AMOUNT=3

# 명령어 허용 공개 범위 (threshold)
# 가능한 값: unlisted / private / direct
# - unlisted : unlisted, private, direct 허용
# - private  : private, direct 허용 (기본값)
# - direct   : direct만 허용
# public은 서버 정책상 어떤 경우에도 차단됩니다.
ALLOWED_VISIBILITY=private

# ============================================================
# 사용 가능한 BOT_TYPE 목록 (BOT*_BOT_TYPE 설정용 참고)
# ============================================================
# default      : 다이스, 운세, 커스텀 명령어만 처리
# store        : default + 소지금/소지품/상점/구매/양도
# stats        : store + 체력·정신력 등 스탯 변동, [사용], [상태 확인], [스탯 관리]
# investigate  : 조사 전용 - [장소 목록]/[진입]/[조사]만 처리
#                그 외 모든 명령어(다이스, 운세, 커스텀 포함)는 조용히 무시
#                별도 스프레드시트(INVESTIGATION_SHEET_ID) 필요
#
# ⚠ 위 4가지 외 값은 비공식이므로 정식 이름을 사용하는 것을 권장합니다.

# ============================================================
# 봇 1: SYSTEM (시스템 명령어 전담)
# ============================================================
# 담당: 커스텀, 상태확인, 가방, 주사위, 운세, 랜덤, 도움말, 캐시 리셋, 소지금 추가, 소지금 차감, 스탯 변동

BOT1_ENABLED=True
BOT1_NAME=sys
BOT1_ACCESS_TOKEN=
BOT1_COMMAND_FILTER=
BOT1_RESPONSE_PREFIX='✶ '
BOT1_LOG_FILE=logs/sys.log
BOT1_IGNORED_KEYWORDS=
BOT1_BOT_TYPE=default    # default | store | stats | investigate
BOT1_HELP_SHEET=도움말(시스템)

# ============================================================
# 봇 2: STORE (상점 명령어 전담)
# ============================================================
# 담당: 상점, 구매, 아이템설명, 아이템사용, 양도, 도움말

BOT2_ENABLED=True
BOT2_NAME=sto
BOT2_ACCESS_TOKEN=
BOT2_COMMAND_FILTER=
BOT2_RESPONSE_PREFIX='✶ '
BOT2_LOG_FILE=logs/sto.log
BOT2_IGNORED_KEYWORDS=
BOT2_BOT_TYPE=store    # default | store | stats | investigate
BOT2_PREMIUM_TRANSFER_ENABLED=True
BOT2_HELP_SHEET=도움말(상점)

# ============================================================
# 봇 3: 게임, 카드, 등등...
# ============================================================
# 담당: 기타 작업

BOT3_ENABLED=False
BOT3_NAME=admin_bot
BOT3_ACCESS_TOKEN=여기에_봇3_토큰_입력
BOT3_COMMAND_FILTER=help,
BOT3_RESPONSE_PREFIX='✶ '
BOT3_LOG_FILE=logs/bot_etc.log
BOT3_IGNORED_KEYWORDS=
BOT3_BOT_TYPE=etc    # default | store | stats | investigate  (현재 'etc'는 비공식 값)

# ============================================================
# 봇 4: INVESTIGATE (조사 전용) — 템플릿
# ============================================================
# 활성화하려면:
#   1) 위쪽 INVESTIGATION_ENABLED=True + INVESTIGATION_SHEET_ID 입력
#   2) BOT4_ENABLED=True + BOT4_ACCESS_TOKEN 입력
#   3) 파일 상단 BOT_COUNT=4 로 변경

BOT4_ENABLED=False
BOT4_NAME=inv
BOT4_ACCESS_TOKEN=
BOT4_COMMAND_FILTER=
BOT4_RESPONSE_PREFIX='⌖ '
BOT4_LOG_FILE=logs/inv.log
BOT4_IGNORED_KEYWORDS=
BOT4_BOT_TYPE=investigate    # default | store | stats | investigate
BOT4_HELP_SHEET=도움말

# ============================================================
# 프로세스 모니터링 (Phase 4)
# ============================================================

PROCESS_MONITOR_ENABLED=True
AUTO_RESTART_ON_CRASH=True
RESTART_DELAY_SECONDS=5
MAX_RESTART_ATTEMPTS=3
HEALTHCHECK_INTERVAL_SECONDS=60

# ============================================================
# 공유 리소스 관리 (Phase 5)
# ============================================================

# 리소스 락 (동시 쓰기 방지)
ENABLE_RESOURCE_LOCKING=True
RESOURCE_LOCK_TIMEOUT=30.0

# Rate Limiting (API 할당량 관리)
ENABLE_RATE_LIMITING=True
SHEETS_READ_RPM=50          # 3개 봇 기준 권장값
SHEETS_WRITE_RPM=50
SHEETS_GLOBAL_RPM=90

# ============================================================
# 워크시트 이름
# ============================================================

HELP_SHEET=도움말
LIST_SHEET=명단
CUSTOM_SHEET=커스텀
FORTUNE_SHEET=운세
SHOP_SHEET=상점

# ============================================================
# 로깅 설정
# ============================================================

LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760      # 10MB
LOG_BACKUP_COUNT=5
ENABLE_CONSOLE_LOG=True

# ============================================================
# 기타 설정
# ============================================================

# 폴링
POLLING_INTERVAL=30

# 캐시
CACHE_TTL=3600
FORTUNE_CACHE_ENABLED=True

# 디버그
DEBUG_MODE=False
