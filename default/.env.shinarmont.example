# ============================================================
#  시너몬트(Shinarmont) 봇 · 5슬롯 멀티봇 설정
# ============================================================
#  ▶ 사용법: 이 파일을 .env 로 복사해서 실행
#       cp .env.shinarmont.example .env
#
#  ▶ 기동 전 점검:  python tools/check_setup.py
#
#  슬롯 매핑
#    BOT1 @SYSTEM  재화·상점·능력치·관리 (공개)   + 스케줄러 소유
#    BOT2 @TOWN    진입·조사·추적           (DM 전용)
#    BOT3 @STORY   대화·고발·결과보고·교류·투표 (DM 전용)
#    BOT4 @DOCTOR  의무실 방문             (DM 전용)
#    BOT5 @BAR     슬롯머신·크랩스·블랙잭    (공개)
# ============================================================


# ============================================================
# 멀티봇 · 스프레드시트 (3종)
# ============================================================
ENABLE_MULTI_BOT=True
# 비워도 된다(아래 BOTn_ENABLED로 결정). 숫자 설정은 빈 값이면 기본값으로 넘어간다.
BOT_COUNT=

# 기본 시트 (명단·도움말·관리·상점·커스텀·운세)
SHEET_ID=

# 시스템 시트 (행동로그·투표·고발·부탁지령·추적·추적기록·소문·이성·설정)
# ※ '부탁지령기록'은 2026-07-16 폐지 — '부탁지령'의 상태/완료 열로 일원화
SYSTEM_SHEET_ID=
SYSTEM_SHEET_ENABLED=True

# 조사 시트 (진입 + 예외 + 로그 + 장소별 워크시트)
# 명세: docs/조사봇_개발_가이드.md
INVESTIGATION_ENABLED=True
INVESTIGATION_SHEET_ID=
INVESTIGATION_ENTRY_SHEET=진입
INVESTIGATION_EXCEPTION_SHEET=예외
INVESTIGATION_LOG_SHEET=로그

# 장소 시트로 오인하면 안 되는 워크시트(템플릿 등). 쉼표 구분.
INVESTIGATION_EXCLUDED_SHEETS=복사용

# 조사 시트 읽기 캐시 TTL(초). 3시간(10800).
# 개방 여부·스탯 등 정합성이 중요한 읽기는 코드가 캐시를 우회하므로([진입]·[조사]는
# 항상 최신), 길게 잡아도 판정은 정확하다. 영향받는 건 [장소 목록]의 최신성뿐.
# GM이 시트를 고친 뒤 즉시 반영하려면 @TOWN 봇에 [캐시 리셋/전체]를 보낼 것.
INVESTIGATION_CACHE_TTL=10800

# 일일 조사 횟수 (성공한 [조사]만 카운트). 판정 기준은 '로그' 시트 집계.
INVESTIGATION_DAILY_LIMIT=2

# 조사 자격 박탈(운영 결정) — [장소 목록]·[진입]·[조사]를 모두 막는다.
# 형식: 콤마 구분 `아이디[:일차]`. 예) evaristo:4  (4일차=2026-07-20 만 박탈),
#   evaristo:4-6(범위), evaristo(모든 날), evaristo:4,mika:2(여러 명).
# 문구: INVESTIGATION_MSG_DISQUALIFIED (기본 '금일 조사 자격이 박탈되었습니다.')
INVESTIGATION_DISQUALIFIED=evaristo:4

# 관리 시트 조사 카운터 컬럼에 횟수를 미러링(GM 트래킹용). 판정 기준은 '로그' 시트.
# ⚠️ 컬럼명은 **실제 시트 헤더**와 같아야 한다(2026-07-16 실측: '추적'/'조사').
#    다르면 미러링이 조용히 생략되고, 추적은 아예 항상 실패한다.
INVESTIGATION_MIRROR_COUNTER=True
INVESTIGATION_COUNTER_COLUMN=조사

# 추적 일일 카운터 컬럼(`관리` 시트)
TRACK_COUNTER_COLUMN=추적

# 조사 결과 문구에 이성 왜곡(마스킹/오정보) 적용
INVESTIGATION_DISTORTION_ENABLED=True

# 스탯 클램프 범위
INVESTIGATION_STAT_MIN=0
INVESTIGATION_STAT_MAX=100

# --- 조사 자동 개방 스케줄러 ---
INVESTIGATION_OPEN_HOUR=21
INVESTIGATION_OPEN_MINUTE=0
INVESTIGATION_OPEN_SCHEDULE=1주-4일차=2026-07-20,2주-8일차=2026-07-24,2주-11일차=2026-07-27,3주-16일차=2026-08-01,3주-18일차=2026-08-03,3주-20일차=2026-08-05,4주-23일차=2026-08-08,4주-26일차=2026-08-11

# 버전 전환 시 이전 버전 행에 쓸 '불가능' 값.
# GM 드롭다운 선택지와 철자를 맞출 것(안 맞아도 동작은 하지만 시트에 경고 표시가 뜬다).
INVESTIGATION_UNAVAILABLE_VALUE=불가능

# 놓친 개방(봇 다운 등) 처리. True면 관리자에게 알리기만 하고 실행하지 않는다.
# (운영진이 수동으로 닫아 둔 행을 되켤 위험 때문. [조사 개방/일차]로 확인 후 수동 실행)
INVESTIGATION_MISSED_OPEN_CONFIRM=True

# 개방 실행 기록(멱등성·놓친 실행 감지)
INVESTIGATION_OPEN_STATE_FILE=state/investigation_opens.json

# 오픈일 조사 횟수 보정: off / reset / plus_one
INVESTIGATION_OPEN_ADJUST=off

# 실패 응답 문구 (세계관 톤 유지, 시스템 용어 노출 금지)
INVESTIGATION_MSG_NO_SUCH_PLACE=마을에 존재하지 않는 장소다.
INVESTIGATION_MSG_CANNOT_ENTER=이곳에는 현재 조사할 수 있는 것이 없다. (조사 포인트가 있는 장소에 진입해야만 조사 가능.)
INVESTIGATION_MSG_NO_SUCH_POINT=이 장소에서는 더 조사할 것이 없다.
INVESTIGATION_MSG_DAILY_LIMIT=오늘은 피곤하다. 내일 다시 살펴보는 게 좋겠다. (조사 횟수 소진.)
INVESTIGATION_MSG_NO_MONEY=주머니 사정이 여의치 않다.
INVESTIGATION_MSG_NOT_ENTERED=어느 장소를 방문할지 먼저 정해야 한다. [진입/장소명]
INVESTIGATION_MSG_NO_LOCATIONS=지금은 어디도 둘러볼 만한 곳이 없다.
INVESTIGATION_MSG_NO_CHARACTER=아직 이 마을 사람으로 등록되지 않았다.
INVESTIGATION_MSG_TEMPORARY=지금은 생각이 잘 정리되지 않는다. 잠시 후 다시 시도해 보자.

# 구글 인증 / 드라이브
# ⚠️ 루트 credentials.json 계정은 '기본' 시트에 **읽기 전용**이라 크레덴셜 풀이 쓰지 않는다.
#    credentials/ 디렉터리가 비었을 때만 폴백으로 쓰인다.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=

# ============================================================
# 크레덴셜 풀 — API 쿼터 분산 + 소진 시 대여
# ============================================================
# Sheets 쿼터는 **프로젝트 단위**(읽기 300회/분). credentials/ 의 계정들은 서로 다른
# 프로젝트라, 기능별로 나눠 쓰면 쿼터가 그만큼 늘어난다.
# 주 크레덴셜이 429에 걸리면 뒤 후보를 빌려 즉시 재시도한다(쿨다운 후 원복).
#
# 2026-07-16 실측: credentials/ 의 5개 계정 모두 3개 시트에 **쓰기 가능**.
CREDENTIALS_DIR=credentials

# 용도별 우선순위(첫 번째=주, 나머지=대여 후보). 파일명에서 _credentials.json을 뗀 이름.
#   main          = 기본 시트(관리: 출석·소지금·스탯) — 가장 무겁고 쓰기가 많다
#   system        = 시스템 시트(행동로그·투표·추적·소문)
#   investigation = 조사 시트(진입·장소·예외·로그)
CREDENTIAL_MAIN=genesis,oblivion,koltsevaya
CREDENTIAL_SYSTEM=koltsevaya,pgd,shinarmont
CREDENTIAL_INVESTIGATION=shinarmont,pgd,genesis

# 할당된 것이 전부 쿼터에 걸리면 다른 용도의 계정까지 빌릴지
CREDENTIAL_BORROW_ENABLED=True
# 쿼터 소진 계정을 쉬게 하는 시간(초). 5분.
# 쉬는 동안 후보를 빌려 쓰고, 5분이 지나면 **주 크레덴셜로 돌아간다**
# (돌아가서 성공하면 계속 주 크레덴셜을 쓴다).
# 짧게 잡으면 회복되자마자 다시 몰려가 곧바로 또 429를 맞는다.
CREDENTIAL_COOLDOWN=300


# ============================================================
# 마스토돈 · 가동 기간
# ============================================================
MASTODON_API_BASE_URL=https://your.mastodon.instance
SYSTEM_ADMIN_ID=

# 공개 범위 기본값 (슬롯별로 아래에서 개별 지정: 마을/스토리/의사=direct)
# 슬롯 전역 허용 범위. 단, **명령어별 허용 범위표(utils/command_visibility.py)가 있으면
# 그 표가 우선한다.** 이 값은 표에 없는 명령어(도움말·가방·관리자 명령 등)에만 적용된다.
#   예: [출석]은 표가 '팔로워 전용'이라 아래 값과 무관하게 DM으로 보내면 거절된다.
# 위반 안내 문구 템플릿은 VISIBILITY_ERROR_TEMPLATE로 수정 가능.
ALLOWED_VISIBILITY=unlisted

# 가동 기간 (KST, YYYY.MM.DD)
BOT_OPERATION_START=2026.07.17
BOT_OPERATION_END=2026.08.14


# ============================================================
# 게임 · 일차 · 능력치
# ============================================================
# 일차: 2026-07-17 = 1일차 ~ 2026-08-14 = 29일차
GAME_START_DATE=2026.07.17
GAME_END_DATE=2026.08.14

# 화폐
CURRENCY=달러
CURRENCY_EUNNEUN=는

# 임계치
HEALTH_HOSPITALIZE_THRESHOLD=10     # 건강 이하 → 강제 입원(마을 활동 차단)
SANITY_DISTORTION_THRESHOLD=40      # 이성 이하 → 조사/추적/소문 텍스트 마스킹
SANITY_HALLUCINATION_THRESHOLD=20   # 이성 이하 → 오정보/환각
SANITY_MSG1_THRESHOLD=50            # 이성 이하 → 이성 경고 문구1 자동 DM(고정 문구, stat_gate.py)
SANITY_MSG2_THRESHOLD=20            # 이성 이하 → 이성 경고 문구2 자동 DM
HEALTH_MSG1_THRESHOLD=50            # 건강 이하 → 건강 경고 문구1 자동 DM(고정 문구, stat_gate.py)
HEALTH_MSG2_THRESHOLD=20            # 건강 이하 → 건강 경고 문구2 자동 DM

# 교류·고발·의무실
EXCHANGE_SANITY_PER_LEVEL=5         # 교류 이성 회복 = 농도(1~5) × 이 값
                                    # 1단계=5 · 2단계=10 · 3단계=15 · 4단계=20 · 5단계=25
                                    # 시전자·상대 **양쪽 모두** 회복(상한 100)
ACCUSE_REWARD=50                    # 고발 시 고발자에게 지급
INFIRMARY_HEAL_HEALTH=2d6+2         # 규칙 폴백/과잉심문 시 건강 회복량 원천식
INFIRMARY_HEAL_SANITY=2d6+2         # 규칙 폴백 시 이성 회복량 원천식
DOCTOR_TREAT_DELTA_MAX=12           # 처치 1회로 오를 수 있는 건강/이성 최대(+)
DOCTOR_TREAT_DELTA_MIN=-6           # 과잉심문 등으로 내려갈 수 있는 이성 최저 변동(-)
# 의사가 대화 흐름을 보며 스스로 진료를 마무리(마무리 시 처치 확정)
DOCTOR_MAX_TURNS=8                  # 의사 발화 하드 상한(이 턴엔 무조건 종료)
DOCTOR_TURNS_MIN=2                  # 의사 최소 발화(그 전엔 종료 안 함)
DOCTOR_TURNS_IDEAL_MIN=3            # 이상적 종료 하한
DOCTOR_TURNS_IDEAL_MAX=6            # 이상적 종료 상한

# 도박
BET_MAX=100                         # 베팅 상한
# 슬롯머신 (BET_MAX와 별개인 전용 한도 — 원 잭팟이 100배라 상한이 크면 경제가 흔들린다)
#   심볼: ▲ △(각 25%) · ■ □(각 20%) · ● ○(각 5%)
#   3개: ●●● 100배 / ■■■ 20배 / ▲▲▲ 10배
#   2개: ●● 1.5배 / ■■ 0.7배 / ▲▲ 0.3배   → RTP 약 89.8%
#   가중치·배율은 게임 규칙이라 코드 상수(commands/shinarmont/slot_command.py).
SLOT_BET_MIN=3
SLOT_BET_MAX=10
# 일일 스핀 제한. 봇 JSON(game_state '오늘슬롯')으로 세며 자정에 자동 해제된다.
# 시트 컬럼을 쓰지 않는다 — 스핀마다 시트를 읽고 쓰면 Sheets 쿼터를 태운다.
SLOT_DAILY_LIMIT=20
# 크랩스 (다단계: [크랩스/베팅액] → [주사위 굴림])
#   컴아웃 7·11 즉시 승리 → 순이익 +베팅×2 / 2·3·12 패배
#   포인트 재현 승리      → 순이익 +베팅×1
#   베팅은 판이 끝날 때 정산한다(미리 차감하지 않는다 → 판이 사라져도 손실 없음).
CRAPS_BET_MIN=1
CRAPS_BET_MAX=100
CRAPS_MAX_REROLLS=3
# 일일 제한. 봇 JSON(game_state '오늘크랩스')으로 세며 자정에 자동 해제.
CRAPS_DAILY_LIMIT=20



# 블랙잭 딜러(NPC)가 소프트 17(A+6)에서 한 장 더 받을지.
#   True  = H17. 카지노 표준이자 참조 구현(bot-cm-default)과 동일. 하우스에 유리.
#   False = S17. 이용자에게 약간 유리(하우스 엣지 ~0.2%p 낮음).
# 딜러는 이것 말고는 재량이 없다 — 16 이하 히트 / 17 이상 스탠드로 고정.
BLACKJACK_HIT_ON_SOFT_17=True
# 블랙잭 일일 제한(판 단위). 슬롯·크랩스와 같은 방식 — 봇 JSON('오늘블랙잭'), 자정 자동 해제.
# 히트·스탠드는 세지 않는다(딜 1회 = 1판).
BLACKJACK_DAILY_LIMIT=20


# 소문 (요일은 '설정' 시트의 '소문 요일'을 우선 참조; 비우면 스케줄러 기본)
RUMOR_WEEKDAY=
RUMOR_SAMPLE_MIN=3
RUMOR_SAMPLE_MAX=5
RUMOR_RECIPIENTS_MIN=3
RUMOR_RECIPIENTS_MAX=5

# 일일보고 (GM 전용) — @SYSTEM 이 하루치 사건을 모아 DM 타래로 보낸다.
# 소문 제작용. 수동 트리거는 [일일보고] 또는 [일일보고/3].
DIGEST_ENABLED=True
# 수신 계정. 비우면 SYSTEM_ADMIN_ID(=NOTICE)를 쓴다.
DIGEST_RECIPIENT_ID=
# 발송 시각(KST). 00:00 리셋 **전에** 보내야 한다 —
# 자정을 넘기면 GM이 '현재 일차'를 넘긴 뒤라 엉뚱한 날을 보고한다.
DIGEST_HOUR=23
DIGEST_MINUTE=30
# 소문 씨앗(AI 각색안) 사용 여부. False면 사실 절만 보낸다.
DIGEST_AI_SEEDS=True
DIGEST_SEED_COUNT=8
# 의무실 진료 대화록을 보고서에 실을지. 러너가 실제로 친 말이라 소문 재료로는
# 제일 진하지만, 그만큼 보고서가 길어진다. 발화 하나당 아래 글자수까지만 싣는다.
DIGEST_INCLUDE_TRANSCRIPT=True
DIGEST_TRANSCRIPT_CHARS=300
# 한 통 최대 글자수. shinarmont.site 는 공백 미포함 5천자라 여유를 뒀다.
DIGEST_CHUNK_LIMIT=4800

# ── 소문 브리핑(재구성) ──
# 기존 상세 보고 대신 '소문 씨앗 4줄 + 참고'만 담은 한 통짜리 브리핑을 보낸다.
# DIGEST_BRIEF=True → 브리핑 발송. LEGACY_REPORT=True → 기존 상세 보고를 별도 타래로 병행.
DIGEST_BRIEF=True
DIGEST_LEGACY_REPORT=False
DIGEST_MAX_SEEDS=8            # DM에 싣는 씨앗 최대 수
DIGEST_MIN_SEED_SCORE=4      # 이 점수 미만 씨앗은 탈락(단일 약신호는 씨앗이 아니다)
DIGEST_GAMBLE_THRESHOLD=5    # 도박 이상 감지 기준 횟수
DIGEST_MONEY_RATIO=2.5       # 소지금 이상 감지 평균 배수
DIGEST_MONEY_FLOOR=15        # 소지금 하한 이상 감지
DIGEST_SANITY_DROP=8         # 이성 하락 이상 감지(전일 대비, 데이터 있을 때만)
DIGEST_HEALTH_DROP=10        # 건강 하락 이상 감지(전일 대비, 데이터 있을 때만)
DIGEST_WITNESS_WINDOW_MIN=60 # 목격자 판정 시간 창(분)
DIGEST_BRIEF_LIMIT=2000      # 브리핑 한 통 목표 길이(초과 시 분할)
DIGEST_BRIEF_EVIDENCE_CHARS=220
# 진술 모순·은밀 지령 감지 키워드(쉼표 구분)
DIGEST_CONTRADICTION_KEYWORDS=번복,불일치,함구,얼버무,방어적,어긋남,캐물었으나,말이 바뀌
DIGEST_SECRET_KEYWORDS=서명은 없었다,적지 말아,눈에 띄지 않는,사본을 보관,갖고 있어 주게


# ============================================================
# 상점 · 출석 · 상태확인 · 양도
# ============================================================
# 상태 확인에 노출할 컬럼
PEEK_STATUS=True
PEEK_HEADER=소지금,소지품,건강,이성

# 출석: [출석] = 오늘의 운세 + ATTENDANCE_AMOUNT 지급 (1일 1회)
#
# ⚠️ 하루 1회 판정의 기준은 **`관리` 시트의 출석 컬럼**이다(봇 JSON 아님).
#    - 컬럼명 = ATTENDANCE_COMMAND 값과 동일 (아래 '출석')
#    - 빈칸 = 오늘 출석 안 함 / 'O'(알파벳 대문자) = 출석함
#    - **컬럼이 없으면 봇이 출석을 거절한다(fail closed).** 없는 채로 진행하면
#      일일 제한이 사라져 소지금을 무한히 받을 수 있기 때문. 반드시 컬럼을 만들 것.
#    - 00:00 KST 초기화(O → 빈칸)는 **별도 스케줄러 봇의 책임**이다.
#      이 봇은 칸을 비우지 않는다. 그 봇이 멈추면 아무도 출석할 수 없다.
ATTENDANCE_ENABLED=True
ATTENDANCE_COMMAND=출석
ATTENDANCE_AMOUNT=3

# 양도(달러/아이템)
PREMIUM_TRANSFER_ITEM_ENABLED=True
PREMIUM_TRANSFER_MONEY_ENABLED=True

# 커스텀 명령어 이미지 컬럼 / 응답 이미지
PREMIUM_CUSTOMC_ENABLED=True
PREMIUM_IMAGE_ENABLED=False


