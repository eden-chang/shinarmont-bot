# ===== 필수 설정 =====

# Google Sheets 설정
GOOGLE_SHEET_ID=your_google_sheet_id_here
# 예시: 1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890AbCdE

# Mastodon 설정
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here
# 예시: abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
MASTODON_API_BASE_URL=https://your.mastodon.instance
# 예시: https://mastodon.social 또는 https://your-instance.com

# ===== 선택적 설정 =====

# 모니터링 주기 설정 (분 단위)
MONITOR_INTERVAL_MINUTES=30
# 기본값: 30분
# 최소 권장: 5분 (Google Sheets API 제한 고려)
# 예시: 10, 15, 30, 60

# 로깅 설정
LOG_LEVEL=INFO
# 옵션: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: 모든 상세 로그 (개발/디버그 시)
# INFO: 일반적인 운영 로그 (권장)
# WARNING: 경고 및 오류만
# ERROR: 오류만
# CRITICAL: 치명적 오류만

# ===== 고급 설정 (기본값 사용 권장) =====

# 재시도 설정
# MAX_RETRIES=5
# RETRY_DELAY=60

# 오류 처리 설정
# MAX_CONSECUTIVE_FAILURES=10
# MAX_RESTART_ATTEMPTS=3

# 헬스체크 설정
# HEALTH_CHECK_INTERVAL=300

# 회로 차단기 설정
# SHEETS_FAILURE_THRESHOLD=3
# SHEETS_TIMEOUT=300
# MASTODON_FAILURE_THRESHOLD=5
# MASTODON_TIMEOUT=180

# ===== 설정 가이드 =====

# 1. Google Sheets 설정:
#    - Google Cloud Console에서 서비스 계정 생성
#    - credentials.json 파일을 봇과 같은 디렉토리에 배치
#    - 스프레드시트를 서비스 계정과 공유
#    - 스프레드시트 URL에서 ID 추출

# 2. Mastodon 설정:
#    - Mastodon 계정 > 환경설정 > 개발 > 새 애플리케이션
#    - 권한: read, write (DM 전송용)
#    - 액세스 토큰 복사

# 3. 로그 레벨 권장사항:
#    - 개발/테스트: DEBUG
#    - 운영 환경: INFO
#    - 문제 발생 시: DEBUG로 일시 변경