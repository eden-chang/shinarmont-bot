# ===== 필수 설정 =====

# Google Sheets 설정 (credentials.json 을 봇과 같은 디렉토리에 두고 시트를 서비스 계정과 공유)
# '관리' 워크시트가 있는 스프레드시트 ID
MANAGE_SHEET_ID=your_manage_sheet_id_here
# '이성' 워크시트(이성문구1/이성문구2)가 있는 스프레드시트 ID
SANITY_SHEET_ID=your_sanity_sheet_id_here

# Mastodon 설정 (권한: read, write — DM 전송용)
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here
MASTODON_API_BASE_URL=https://your.mastodon.instance

# ===== 선택적 설정 =====

# 워크시트 이름 (기본값: 관리 / 이성)
MANAGE_WORKSHEET=관리
SANITY_WORKSHEET=이성

# 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
